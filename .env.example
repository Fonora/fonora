# Fonoran OAuth (Google for community + admin via ADMIN_EMAILS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Vocabulary admin — only these emails can edit canon in Word Manager
ADMIN_EMAILS=info@fonora.org

# Legacy: no longer restricts community sign-in (any verified Google email)
# ALLOWED_DOMAIN=fonora.org

# Optional: force callback URL (default: derived from request host)
# AUTH_CALLBACK_URL=http://localhost:8000/auth/callback

# Local dev: skip auth even when OAuth vars are set
# FONORAN_AUTH=off   # local opt-out only — omit in production (Heroku)

# Optional: warn when preferred compounds flatten to more than N atomic roots (default 4)
# FONORAN_MAX_FLATTENED=4

# Local dev: skip all learn answer checks — any response counts as correct
# EDU_DEBUG_MODE=true

# Fonoran storage
# Production: set DATABASE_URL (Heroku Postgres etc.) and FONORAN_STORAGE=postgres
# Local dev:  createdb fonora && set both vars below, then npm run fonoran:regenerate
# DATABASE_URL=postgres://localhost/fonora
# FONORAN_STORAGE=postgres
# PGSSLMODE=disable        # local only — Heroku sets SSL automatically
# FONORAN_SKIP_JSON_MIRROR=1

# External generated data (Fonora/fonora-data submodule)
# FONORAN_DATA_DIR=external/fonora-data
# FONORAN_SKIP_DATA_FETCH=1   # skip GitHub tarball fetch (local submodule already present)
